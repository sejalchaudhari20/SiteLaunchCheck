generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Report {
  reportId      String   @id
  url           String
  timestamp     String
  overallScore  Int
  launchStatus  String
  summary       String   // JSON stringified
  categoryScores String  // JSON stringified
  results       String   // JSON stringified
}

model Feedback {
  id           String   @id
  auditId      String?
  auditUrl     String?
  sessionId    String?
  rating       Int?
  helpful      Boolean?
  feedbackType String?
  message      String
  email        String?
  device       String?
  createdAt    String
  status       String
  source       String
}
